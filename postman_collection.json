        {
            "name": "Order",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "[\n    {\n        \"id\": 1,\n        \"quantity\": 2\n    }\n]"
                        },
                        "url": {
                            "raw": "http://localhost:3000/order/create-order",
                            "host": ["localhost"],
                            "port": "3000",
                            "path": ["order", "create-order"]
                        }
                    },
                    "response": [
                        {
                            "code": 201,
                            "name": "Order created successfully",
                            "body": "{\"message\":\"Order created successfully\"}",
                            "status": "Created"
                        },
                        {
                            "code": 400,
                            "name": "Bad Request",
                            "body": "{\"message\":\"Insufficient quantity or invalid input\"}",
                            "status": "Bad Request"
                        },
                        {
                            "code": 404,
                            "name": "Not Found",
                            "body": "{\"message\":\"Grocery not found\"}",
                            "status": "Not Found"
                        },
                        {
                            "code": 500,
                            "name": "Internal Server Error",
                            "body": "{\"message\":\"Error creating order\"}",
                            "status": "Internal Server Error"
                        }
                    ]
                },
                {
                    "name": "Get Order History",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:3000/order/order-history",
                            "host": ["localhost"],
                            "port": "3000",
                            "path": ["order", "order-history"]
                        }
                    },
                    "response": [
                        {
                            "code": 200,
                            "name": "OK",
                            "body": "[{\"id\": 1, \"quantity\": 2, \"createdAt\": \"2025-01-17T10:00:00Z\"}]",
                            "status": "OK"
                        },
                        {
                            "code": 500,
                            "name": "Internal Server Error",
                            "body": "{\"message\":\"Error fetching order history\"}",
                            "status": "Internal Server Error"
                        }
                    ]
                }
            ]
        },
